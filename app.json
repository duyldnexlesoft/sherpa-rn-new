{
  "expo": {
    "name": "Sherpa",
    "slug": "sherpa-app",
    "version": "3.0.0",
    "web": {
      "favicon": "./app/assets/image/Onboarding.png "
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/image/Onboarding.png",
          "dark": {
            "image": "./app/assets/image/Onboarding.png"
          },
          "imageWidth": 1024
        }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "appId": "l2hpbrqs",
          "androidApiKey": "android_sdk-92047e4ccd9bc9c607663bbe871587ea8ba4502a",
          "iosApiKey": "ios_sdk-32fade9ec5dfcc3ce5543c96e7f2232ae4f00af5",
          "intercomRegion": "US"
        }
      ],

      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.8.0",
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoiZ293aXRoc2hlcnBhIiwiYSI6ImNseGoxN2U1bDF2Z2wycW9kcnJlbnhrYW4ifQ.iYIQLy1o09GxK9O8Dya4hw"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sherpa uses your location to filter services to nearby offerings."
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./app/assets/image/AppIcon1024.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.medium.GoSherpa",
      "icon": {
        "dark": "./app/assets/image/AppIcon1024.png",
        "light": "./app/assets/image/AppIcon1024.png"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Use Camera for upload image.",
        "NSPhotoLibraryUsageDescription": "This app would like to save images to your device.",
        "NSPhotoLibraryAddUsageDescription": "This app would like to save images to your device.",
        "NSLocationWhenInUseUsageDescription": "Sherpa uses your location to filter services to nearby offerings."
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/image/AppIcon1024.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.sherpareactnativeapp",
      "edgeToEdgeEnabled": true
    }
  }
}
